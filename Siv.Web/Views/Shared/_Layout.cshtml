<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Titulo"] · SIV</title>
    <link rel="stylesheet" href="~/css/siv.css" asp-append-version="true" />
</head>
<body>
    <header class="siv-nav">
        <div class="siv-nav__contenido">
            <a asp-controller="Home" asp-action="Index" class="siv-nav__marca">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-1 .1-1.3.4l-.7.7c-.4.4-.3 1 .2 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.6 6c.3.5.9.6 1.3.2l.7-.7c.3-.3.5-.8.4-1.3Z" />
                </svg>
                <span>
                    SIV
                    <span class="siv-nav__marca-sub">Sistema de Información de Vuelos</span>
                </span>
            </a>
            <nav>
                <ul class="siv-nav__enlaces">
                    <li>
                        <a asp-controller="Disponibles" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Disponibles" ? "activo" : "")">
                            <span aria-hidden="true">✈</span>
                            Buscar vuelos
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true && (User.IsInRole("UsuarioRegistrado") || User.IsInRole("Admin")))
                    {
                        <li>
                            <a asp-controller="Reservas" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservas" ? "activo" : "")">
                                <span aria-hidden="true">▣</span>
                                Mis reservas
                            </a>
                        </li>
                    }
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "activo" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            Inicio
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Vuelos" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Vuelos" ? "activo" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-1 .1-1.3.4l-.7.7c-.4.4-.3 1 .2 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.6 6c.3.5.9.6 1.3.2l.7-.7c.3-.3.5-.8.4-1.3Z" /></svg>
                            Vuelos
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Notificaciones" asp-action="Index" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Notificaciones" ? "activo" : "")">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            Notificaciones
                        </a>
                    </li>
                </ul>
                <div class="siv-nav__auth" style="display: flex; align-items: center; gap: 1rem;">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span style="color: rgba(255,255,255,0.85); font-weight: 500; font-size: 0.9rem;">Hola, @User.Identity.Name</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" style="margin: 0;">
                            <button type="submit" class="siv-boton siv-boton--peligro siv-boton--chico">Salir</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Registro" class="siv-boton siv-boton--secundario siv-boton--chico">Crear cuenta</a>
                        <a asp-controller="Auth" asp-action="Login" class="siv-boton siv-boton--primario siv-boton--chico">Ingresar</a>
                    }
                </div>
            </nav>
        </div>
    </header>

    <main class="siv-contenedor">
        @RenderBody()
    </main>

    <footer class="siv-pie">
        SIV · Sistema de Información de Vuelos — Proyecto académico de arquitectura n-layer
    </footer>

    <!-- Toast container para notificaciones -->
    <div id="toast-container" style="position: fixed; bottom: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.12/signalr.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("http://localhost:5200/notificacionesHub")
                    .configureLogging(signalR.LogLevel.Information)
                    .build();

                connection.on("RecibirNotificacion", function (mensaje) {
                    mostrarToast(mensaje);
                });

                async function start() {
                    try {
                        await connection.start();
                        console.log("SignalR Connected.");
                        // El hub obtiene el usuario directamente del token autenticado.
                        await connection.invoke("Identificarse");
                    } catch (err) {
                        console.error("SignalR Connection Error: ", err);
                        setTimeout(start, 5000);
                    }
                }

                connection.onclose(async () => {
                    await start();
                });

                start();

                function mostrarToast(mensaje) {
                    const container = document.getElementById("toast-container");
                    const toast = document.createElement("div");
                    toast.className = "siv-tarjeta siv-alerta siv-alerta--info";
                    toast.style.width = "300px";
                    toast.style.boxShadow = "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)";
                    toast.style.animation = "slideIn 0.3s ease-out forwards";
                    
                    toast.innerHTML = `
                        <div style="display:flex; align-items:flex-start; gap:0.75rem;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" style="margin-top: 2px;">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <div>
                                <strong style="display:block; margin-bottom: 0.2rem;">Nueva Notificación</strong>
                                <p style="margin: 0; font-size: 0.9rem;">${mensaje}</p>
                            </div>
                            <button type="button" style="background:transparent; border:none; color:inherit; cursor:pointer; margin-left:auto; opacity: 0.6;" onclick="this.parentElement.parentElement.remove()">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                    `;
                    
                    container.appendChild(toast);
                    
                    // Auto remove after 6 seconds
                    setTimeout(() => {
                        if (toast.parentElement) {
                            toast.style.opacity = "0";
                            toast.style.transition = "opacity 0.3s";
                            setTimeout(() => toast.remove(), 300);
                        }
                    }, 6000);
                }
            });
        </script>
        <style>
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
        </style>
    }
</body>
</html>
