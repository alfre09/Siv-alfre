    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Siv.Domain\Siv.Domain.csproj" />
    <ProjectReference Include="..\Siv.Application\Siv.Application.csproj" />
  </ItemGroup>

