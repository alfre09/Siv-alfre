<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:recursos="clr-namespace:Siv.Desktop.Recursos">

    <recursos:EstadoVueloToColorConverter x:Key="EstadoVueloToColorConverter" />
    <recursos:BooleanToLeidaTextConverter x:Key="BooleanToLeidaTextConverter" />

    <!-- Colores -->
    <Color x:Key="ColorPrimario">#0078D4</Color>
    <SolidColorBrush x:Key="BrushPrimario" Color="{StaticResource ColorPrimario}" />
    
    <Color x:Key="ColorFondoOscuro">#1B2838</Color>
    <SolidColorBrush x:Key="BrushFondoOscuro" Color="{StaticResource ColorFondoOscuro}" />

    <Color x:Key="ColorSuperficie">#2D3748</Color>
    <SolidColorBrush x:Key="BrushSuperficie" Color="{StaticResource ColorSuperficie}" />
    
    <Color x:Key="ColorTextoClaro">#FFFFFF</Color>
    <SolidColorBrush x:Key="BrushTextoClaro" Color="{StaticResource ColorTextoClaro}" />

    <!-- Estilos de botones -->
    <Style TargetType="Button" x:Key="BotonPrimario">
        <Setter Property="Background" Value="{StaticResource BrushPrimario}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoClaro}" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#005A9E" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="BotonMenuNavegacion">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoClaro}" />
        <Setter Property="Padding" Value="15,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2D3748" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Estilos de TextBlock -->
    <Style TargetType="TextBlock" x:Key="TituloPagina">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoClaro}" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <!-- Estilo de DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextoClaro}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="{StaticResource BrushSuperficie}" />
        <Setter Property="AlternatingRowBackground" Value="#222C3A" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#172230" />
        <Setter Property="Foreground" Value="#A0AEC0" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="#4A5568" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource BrushTextoClaro}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#38455A" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushPrimario}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
