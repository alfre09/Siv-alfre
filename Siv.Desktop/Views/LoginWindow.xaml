<Window x:Class="Siv.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIV - Iniciar Sesión" Height="300" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <TextBlock Text="Sistema de Información de Vuelos" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />
        
        <TextBlock Grid.Row="1" Text="Usuario:" Margin="0,0,0,5" />
        <TextBox Grid.Row="2" x:Name="TxtUsuario" Margin="0,0,0,15" Padding="5" />
        
        <TextBlock Grid.Row="3" Text="Contraseña:" Margin="0,0,0,5" />
        <PasswordBox Grid.Row="4" x:Name="TxtPassword" Margin="0,0,0,15" Padding="5" />
        
        <TextBlock Grid.Row="5" x:Name="TxtMensajeError" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" />
        
        <Button Grid.Row="6" Content="Entrar" Width="100" Height="35" HorizontalAlignment="Center" Click="BtnLogin_Click" />
    </Grid>
</Window>
