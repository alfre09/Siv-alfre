<UserControl x:Class="Siv.Desktop.Views.SeguimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Seguimientos" Style="{StaticResource TituloPagina}" />

        <Border Grid.Row="1" Padding="15" Margin="0,0,0,15"
                Background="{StaticResource BrushSuperficie}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Usuario" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="180" Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                <TextBlock Text="Vuelo ID" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Width="100" Text="{Binding VueloIdTexto, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                <Button Content="Seguir vuelo" Command="{Binding CrearSeguimientoCommand}"
                        Style="{StaticResource BotonPrimario}" Margin="0,0,10,0"/>
                <Button Content="Dejar de seguir" Command="{Binding EliminarSeguimientoCommand}"
                        Style="{StaticResource BotonPrimario}" Margin="0,0,10,0"/>
                <Button Content="Refrescar" Command="{Binding CargarDatosCommand}"
                        Style="{StaticResource BotonPrimario}"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Seguimientos}"
                  SelectedItem="{Binding SeguimientoSeleccionado}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding SeguimientoId}" Width="Auto"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="*"/>
                <DataGridTextColumn Header="Vuelo ID" Binding="{Binding VueloId}" Width="Auto"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaSeguimiento, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
